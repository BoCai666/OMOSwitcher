{
  "productName": "OMOSwitcher",
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:7200",
    "beforeDevCommand": "npm run dev"
  },
  "identifier": "com.ohmyopencode.omoswitcher",
  "bundle": {
    "targets": "all",
    "externalBin": [
      "binaries/monitor"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "active": true
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "OMOSwitcher",
        "fullscreen": false,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "width": 800,
        "transparent": false,
        "devtools": true,
        "height": 600,
        "backgroundColor": "#1a1a2e"
      }
    ]
  },
  "version": "2.0.0"
}
