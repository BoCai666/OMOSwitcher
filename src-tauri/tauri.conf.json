{
  "productName": "OMOSwitcher",
  "$schema": "https://schema.tauri.app/config/2",
  "build": {
    "frontendDist": "../dist",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:7200",
    "beforeDevCommand": "npm run dev"
  },
  "identifier": "com.ohmyopencode.omoswitcher",
  "bundle": {
    "targets": "all",
    "resources": [],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "active": true,
    "createUpdaterArtifacts": true
  },
  "app": {
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "OMOSwitcher",
        "fullscreen": false,
        "decorations": false,
        "resizable": true,
        "shadow": true,
        "width": 1280,
        "transparent": false,
        "devtools": true,
        "height": 800,
        "minWidth": 1200,
        "minHeight": 700,
        "backgroundColor": "#1a1a2e"
      }
    ]
  },
  "version": "2.0.17",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE0NzRCMzQzQzQ3M0U4ODMKUldTRDZIUEVRN04wRkJGOWZnRkxwcVEyKzBNTU1FUTZEa0VObndWR05pdG4vWWh6bE8vZ055QzEK",
      "endpoints": [
        "https://github.com/BoCai666/OMOSwitcher/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
