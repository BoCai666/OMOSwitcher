{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OMOSwitcher",
  "version": "0.1.0",
  "identifier": "com.ohmyopencode.omoswitcher",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:7200",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "OMOSwitcher",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false,
        "devtools": true,
        "decorations": false,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.ico"
    ],
    "externalBin": ["binaries/monitor"]
  }
}
