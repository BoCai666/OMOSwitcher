{
  "name": "@omoswitcher/monitor",
  "version": "1.0.0",
  "description": "OpenCode LLM API Monitor - Sidecar for OMOSwitcher",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-migrations",
    "copy-migrations": "node -e \"const fs=require('fs');const path=require('path');fs.mkdirSync('dist/db/migrations',{recursive:true});fs.cpSync('src/db/migrations','dist/db/migrations',{recursive:true})\"",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "pkg": "pkg . --targets node18-win-x64 --output dist/monitor.exe --compress GZip"
  },
  "keywords": [
    "llm",
    "monitor",
    "openai",
    "anthropic",
    "api",
    "sidecar"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mswjs/interceptors": "^0.41.3",
    "@types/node-forge": "^1.3.14",
    "better-sqlite3": "^12.6.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "node-forge": "^1.3.3",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^25.3.2",
    "@types/uuid": "^10.0.0",
    "@yao-pkg/pkg": "^6.14.1",
    "typescript": "^5.9.3"
  },
  "pkg": {
    "assets": [
      "config.jsonc",
      "dist/db/migrations/**/*"
    ],
    "outputPath": "dist"
  }
}
