{
  "name": "@omoswitcher/monitor",
  "version": "1.0.0",
  "description": "OpenCode LLM API Monitor - Sidecar for OMOSwitcher",
  "main": "dist/index.js",
  "bin": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && npm run copy-migrations && npm run copy-wasm",
    "copy-migrations": "node scripts/copy-migrations.cjs",
    "copy-wasm": "node scripts/copy-wasm.cjs",
    "start": "node dist/index.js",
    "dev": "node --watch dist/index.js",
    "clean": "node -e \"fs.rmSync('dist',{recursive:true,force:true})\"",
    "pkg": "pkg . --targets node18-win-x64 --output dist/monitor.exe --compress GZip"
  },
  "keywords": [
    "llm",
    "monitor",
    "openai",
    "anthropic",
    "api",
    "sidecar"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@mswjs/interceptors": "^0.41.3",
    "@types/node-forge": "^1.3.14",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "http-proxy": "^1.18.1",
    "node-forge": "^1.3.3",
    "sql.js": "^1.14.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.15",
    "@types/node": "^25.3.2",
    "@types/sql.js": "^1.4.11",
    "@types/uuid": "^10.0.0",
    "@yao-pkg/pkg": "^6.14.1",
    "typescript": "^5.9.3"
  },
  "pkg": {
    "assets": [
      "dist/db/migrations/**/*",
      "dist/wasm/**/*"
    ],
    "outputPath": "dist"
  }
}
